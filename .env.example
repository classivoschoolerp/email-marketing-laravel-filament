APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# ---------------------------------------------------------------------------
# Reporting read replica (spec §4.6 F-4.6-007) — OFF by default.
# Only App\Support\Database\ReadReplica uses it, and only for reporting reads;
# the rest of the application never touches the replica. Full walkthrough,
# including the MySQL grants and the lag guard, in docs/deploy-mysql.md.
# ---------------------------------------------------------------------------
# DB_READ_REPLICA_ENABLED=true
# DB_READ_HOST=10.0.0.21,10.0.0.22     # comma-separated = several replicas
# DB_READ_PORT=3306
# DB_READ_USERNAME=emp_reporting       # grant SELECT (+ REPLICATION CLIENT)
# DB_READ_PASSWORD=
# DB_READ_REPLICA_CONNECTION=mysql_read
# DB_READ_REPLICA_STICKY=false
#
# Lag guard: reads fall back to the PRIMARY when the replica is further behind
# than DB_READ_REPLICA_MAX_LAG seconds, or when lag cannot be measured at all.
# DB_READ_REPLICA_LAG_GUARD=true
# DB_READ_REPLICA_MAX_LAG=5
# DB_READ_REPLICA_PROBE_TTL=5
# DB_READ_REPLICA_ON_UNKNOWN=primary   # primary (safe) | replica (fail open)

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Plugin marketplace (spec §6.1 F-6.1-016) — OFF by default.
# No official repository is hosted for this platform yet; point this at any
# host serving the index format documented in docs/plugins.md §11.
# D-103 still applies: a checksum proves integrity, never safety.
# ---------------------------------------------------------------------------
# EMP_PLUGIN_MARKETPLACE_URL=https://plugins.example.com
# EMP_PLUGIN_MARKETPLACE_INDEX=index.json
# EMP_PLUGIN_MARKETPLACE_TTL=60
# EMP_PLUGIN_MARKETPLACE_HOSTS=cdn.example.com   # pin package download hosts
# EMP_PLUGIN_MARKETPLACE_ENABLED=true

# ---------------------------------------------------------------------------
# Enterprise SSO — generic OIDC + SAML 2.0 (spec §6.7 F-6.7-002).
# Credentials are configured in Admin → Settings → Enterprise SSO, not here.
# These are protocol-level knobs only. Full walkthrough in docs/sso.md.
# ---------------------------------------------------------------------------
# EMP_OIDC_DISCOVERY_TTL=3600    # seconds the discovery document is cached
# EMP_OIDC_JWKS_TTL=3600         # seconds the IdP's signing keys are cached
# EMP_OIDC_CLOCK_SKEW=60         # tolerated id_token exp/iat skew, seconds
# EMP_OIDC_TIMEOUT=15

# ---------------------------------------------------------------------------
# Ecommerce & integrations (spec §2.12, WP-45).
# Per-tenant shop credentials live encrypted on `store_connections`, and
# per-tenant integration credentials on `customer_integration_credentials` —
# never here. These are operator-level knobs only. See docs/ecommerce.md.
# ---------------------------------------------------------------------------
# ECOM_SYNC_TIMEOUT=20              # seconds allowed per vendor HTTP call
# ECOM_SYNC_PAGE_SIZE=100           # records asked for per page
# ECOM_SYNC_MAX_PAGES=20            # pages ONE job walks before re-dispatching
# ECOM_SYNC_OVERLAP_MINUTES=5       # re-read window so a mid-page write is not skipped
# ECOM_ATTRIBUTION_WINDOW_DAYS=7    # last-touch window; a campaign may widen it
# ECOM_ATTRIBUTION_BASIS=total      # total | subtotal
# ECOM_VISIT_RETENTION_DAYS=180     # §4.5 retention for site-tracking hits
# ECOM_VISIT_COOKIE_DAYS=30         # merchant-domain attribution cookie life
# ECOM_BROWSE_WINDOW_HOURS=24
# ECOM_CART_ABANDON_MINUTES=60      # idle time before a cart counts as abandoned
# ECOM_CART_TICK_LIMIT=200
# ECOM_COUPON_LENGTH=10
# ECOM_COUPON_MAX_BATCH=5000
# ECOM_RECOMMENDATION_LIMIT=3
# ECOM_BEST_SELLER_DAYS=90
# ECOM_INTEGRATION_TIMEOUT=10
