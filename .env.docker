# ---------------------------------------------------------------------------
# Docker compose environment (spec §0.1 F-0.1-011, §6.9 F-6.9-005 — WP-24)
#
#   cp .env.docker .env && docker compose up -d && ./docker/bootstrap.sh
#
# Values match the service names in docker-compose.yml. Change every secret
# before using this anywhere but a laptop.
# ---------------------------------------------------------------------------

APP_NAME="Email Marketing Platform"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# --- Database (MySQL 8, D-03) ---------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=emp
DB_USERNAME=emp
DB_PASSWORD=secret

# --- Redis: queues, cache, locks, counters (D-04) -------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# --- Mail: mailpit catches everything at http://localhost:8025 ------------
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.test"
MAIL_FROM_NAME="${APP_NAME}"

# --- Storage ---------------------------------------------------------------
FILESYSTEM_DISK=local
# S3-compatible object storage (§0.1 F-0.1-009). Point AWS_ENDPOINT at MinIO,
# R2, Spaces, B2 or Wasabi; verify with: php artisan ops:storage-check --disk=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

# --- Broadcasting (§0.1 F-0.1-007). null = disabled; reverb/pusher = live --
BROADCAST_CONNECTION=null
# REVERB_APP_ID=
# REVERB_APP_KEY=
# REVERB_APP_SECRET=
# REVERB_HOST=localhost
# REVERB_PORT=8080
# REVERB_SCHEME=http

# --- Worker identity (§6.6 F-6.6-008 worker registry) ----------------------
# Give each sending node a stable name so the admin registry is readable.
EMP_NODE_NAME=

# --- Optional Horizon (§0.1 F-0.1-005, D-04) ------------------------------
# composer require laravel/horizon  → then HORIZON_PATH is served at /admin/horizon
HORIZON_PATH=admin/horizon
